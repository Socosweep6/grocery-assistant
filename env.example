# Grocery Assistant — environment variable template
# Copy to a file named .env, fill in real values, then: source .env
# Never commit your .env to git.

# ---------------------------------------------------------------------------
# Twilio (required for live SMS hookup)
# ---------------------------------------------------------------------------

# Your Twilio account auth token — find it at console.twilio.com
TWILIO_AUTH_TOKEN=

# Set to 1 to enable Twilio request signature verification.
# Leave unset in dev/local mode. Must be set in production.
TWILIO_VALIDATE_SIGNATURE=1

# Your public-facing webhook URL. Required when running behind ngrok or a
# reverse proxy, because Flask sees the internal URL, not the signed URL.
# Example: https://abc123.ngrok.io/sms/webhook
TWILIO_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Discord (required for live Discord bot hookup)
# ---------------------------------------------------------------------------

# Your Discord bot token — from discord.com/developers/applications -> Bot
DISCORD_BOT_TOKEN=

# Optional: restrict the bot to one channel by channel ID.
# Leave unset to accept messages from all channels the bot can see.
GROCERY_DISCORD_CHANNEL_ID=

# ---------------------------------------------------------------------------
# App (optional overrides — defaults shown)
# ---------------------------------------------------------------------------

# Override the path to the SQLite database file.
# Default: grocery.db in the repo root.
# GROCERY_DB_PATH=

# Override the web server port. Default: 5000.
# GROCERY_PORT=5000

# Base URL the Discord bridge uses to POST to the local web server.
# Default: http://127.0.0.1:5000
# GROCERY_SERVER_URL=http://127.0.0.1:5000
